%% Delete the game/ folder for non-game projects.
flowchart TB
  frame([Frame start]) --> input[Poll input → actions]
  input --> fixed{Accumulated time ≥ fixed dt?}
  fixed -- yes --> sim[Fixed update: physics, gameplay systems]
  sim --> fixed
  fixed -- no --> late[Variable update: animation, camera, UI]
  late --> render[Render with interpolation alpha]
  render --> audio[Audio / events flush]
  audio --> frame
