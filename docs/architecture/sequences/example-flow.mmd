%% owner: architect
sequenceDiagram
  actor U as User
  participant A as app
  participant C as core
  participant I as io
  U->>A: request
  A->>I: load(id)
  I-->>A: entity
  A->>C: apply(entity, command)
  C-->>A: new entity | error
  A->>I: save(new entity)
  A-->>U: response
